#!/bin/sh
# A merge commit does not run pre-commit; this is the same check for it.
# checkit-printit/DESIGN.md section 20.
PY="C:/Users/slye/Projects/checkit-printit/.venv/Scripts/python.exe"
if [ ! -x "$PY" ]; then
  echo "name guard: $PY is missing, so nothing can be checked. Refused." >&2
  exit 1
fi
exec "$PY" -I -m checkit_printit names check --staged
