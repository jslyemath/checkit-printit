\ProvidesPackage{printitfigures}
%
% The picture half of the printit theme: TikZ libraries, the \setmyx/\setmyy
% range helpers, and the pgfplots axis styles that decide what a number line
% or a set of axes looks like.
%
% Separate from printit.sty because figures are compiled on their own. CheckIt
% rasterizes a bank's .tikz files in a `standalone` document to make the images
% the viewer shows, and the full theme cannot load there -- it sets up page
% geometry, headers and footers, and expects \acadclass and \title to have
% been given.
%
% So both surfaces load this one file: the bank's tikz_preamble.tex for
% rasterizing, and printit.sty for the printed document. A number line drawn
% for the web and the same line drawn in a handout are then the same picture,
% not two drawings that have to be kept looking alike.

% Colors, defined here rather than in printit.sty because figures use them:
% a number line marking an answer draws the dot in scCOLOR, and figures are
% compiled on their own without the theme.
%
% The failure this fixes was silent. pdflatex reported an unknown key,
% recovered, drew the dot black, and still produced a PDF -- and the rasterizer
% judges success by whether a PDF appeared.
\usepackage[dvipsnames]{xcolor}
\definecolor{scCOLOR}{HTML}{145da0}
\definecolor{darkergray}{HTML}{404040}

% Mathematics and the text font, here for the same reason. A tick label is
% math -- a number line labelled 5/6 needs \dfrac -- and a figure has to be set
% in the same typeface as the page it sits on, or the web image and the printed
% one disagree about what a numeral looks like.
%
% Undefined \dfrac was the second silent failure: it dropped the fraction bar
% and drew "56" on every published number line carrying a fraction.
\usepackage{amsmath}
\usepackage{amssymb}
\usepackage{mathpazo}

%need these for some of the nifty tikz commands
\usepackage{tikz}
\usepackage{tkz-euclide}
\usepackage{tikz-cd}
\usetikzlibrary{calc,trees,positioning,arrows,fit,shapes,calc,angles,quotes,backgrounds,datavisualization,datavisualization.formats.functions,math,intersections}
\tikzstyle{aligntotop}=[baseline={([yshift={-\ht\strutbox}]current bounding box.north)},outer sep=0pt,inner sep=0pt]

% The twelve range variables, with defaults. \setmyx and \setmyy
% below reset the x and y halves; the pgfplots styles further down read
% them to place ticks and limits.
%
% \xfirst is the odd one out, and deliberately. Its name used to be
% \xa, matching \xz at the other end -- until printit.sty started
% drawing a QR code in the footer, and `qrcode` turned out to open with
%
%     \let\xa=\expandafter
%
% taking the bare name globally and never giving it back. tikzmath will
% only assign to a token whose \meaning is "undefined" or "macro:->..."
% (tikzlibrarymath.code.tex, lines 22-40), and a primitive is neither,
% so every \setmyx in the document then died with
%
%     ! Package tikz Error: tikz math library:
%       Unknown function or keyword '='.
%
% which is fatal: pdflatex writes no PDF at all. A job of F1, F3 and
% F3-E produced nothing. F1 has no figure; F3 opens with \setmyx.
%
% The name cannot be shared. Lending it back inside a group is not
% enough, because `qrcode` caches each computed code in the .aux file
% and expands its own macros again when that is read, outside any group
% this package controls. So qrcode keeps \xa and this one is renamed.
%
% Only \xa was taken. \xz and the ten others keep their names, which is
% why the pair now reads \xfirst .. \xz instead of \xa .. \xz.
\tikzmath{
    \xfirst = -5; \xz = 5;
    \ya = -5; \yz = 5;
    \xs = 1; \ys = 1;
    \xn = \xfirst + 1; \yn = \ya+1;
    \xm1 = \xfirst - \xs; \xm2 = \xz + \xs;
    \ym1 = \ya - \ys; \ym2 = \yz + \ys;
    }

\newcommand{\setmyx}[3][1]{\tikzmath{
    \xfirst = #2; \xz = #3;
    \xs = #1;
    \xn = \xfirst + 1;
    \xm1 = \xfirst - \xs; \xm2 = \xz + \xs;
    }}

\newcommand{\setmyy}[3][1]{\tikzmath{
    \ya = #2; \yz = #3;
    \ys = #1;
    \yn = \ya + 1;
    \ym1 = \ya - \ys; \ym2 = \yz + \ys;
    }}

\usepackage{pgfplots}

\pgfplotsset{compat=newest}

\tikzset{>={Stealth[length=8pt,width=7pt]}}
\pgfplotsset{bluesoldot/.style={color=blue,only marks,mark=*}}
\pgfplotsset{blueholdot/.style={color=blue,fill=white,only marks,mark=*}}
\pgfplotsset{slydes axis style/.style ={
  axis background/.style = {fill=white},
  thick,
  axis x line=center,
  axis y line=center,
  grid = both,
  xticklabel style = {font=\tiny,yshift=0.5ex},
  yticklabel style = {font=\tiny,xshift=0.5ex},
  xlabel style={font=\tiny, xshift=-1.75ex},
  ylabel style={font=\tiny, yshift=-1.75ex},
  xtick={\xfirst,\xn,...,\xz},
  ytick={\ya,\yn,...,\yz},
  every major tick/.append style={thick, major tick length=5pt, black},
  xlabel={$x$},
  ylabel={$y$},
  xlabel style={below right},
  ylabel style={above left},
  xmin=\xm1,
  xmax=\xm2,
  ymin=\ym1,
  ymax=\ym2}}
  \pgfplotsset{printed axis style/.style ={
  axis background/.style = {fill=white},
  thick,
  axis x line=center,
  axis y line=center,
  grid = both,
  xticklabel style = {font=\tiny,yshift=0.5ex},
  yticklabel style = {font=\tiny,xshift=0.5ex},
  xlabel style={font=\tiny, xshift=-1.75ex},
  ylabel style={font=\tiny, yshift=-1.75ex},
  xtick={\xfirst,\xn,...,\xz},
  ytick={\ya,\yn,...,\yz},
  every major tick/.append style={thick, major tick length=5pt, black},
  xlabel={$x$},
  ylabel={$y$},
  xlabel style={below right},
  ylabel style={above left},
  xmin=\xm1,
  xmax=\xm2,
  ymin=\ym1,
  ymax=\ym2}}

\pgfplotsset{number line style/.style ={
  axis background/.style = {fill=none},
  thick,
  yscale=0.1,
  axis x line=center,
  axis y line=none,
  axis line style={Stealth-Stealth},
  xticklabel style = {font=\tiny,yshift=0.5ex},
  xlabel style={font=\tiny, xshift=-1.75ex},
  xtick={\xfirst,\xn,...,\xz},
  every major tick/.append style={thick, major tick length=50pt, black},
  xlabel style={below right},
  xmin=\xm1-0.5,
  xmax=\xm2+0.5,
  ymin=-0.5,
  ymax=0.5}}

\pgfplotsset{blank number line style/.style ={
  axis background/.style = {fill=none},
  thick,
  yscale=0.1,
  axis x line=center,
  axis y line=none,
  axis line style={Stealth-Stealth},
  xticklabel style = {font=\tiny,yshift=0.5ex},
  xtick={\xfirst,\xn,...,\xz},
  every major tick/.append style={thick, major tick length=50pt, black},
  xticklabels=\empty,
  yticklabels=\empty,
  xmin=\xm1-0.5,
  xmax=\xm2+0.5,
  ymin=-0.5,
  ymax=0.5}}

\pgfplotsset{blank axis style/.style ={
  axis background/.style = {fill=white},
  thick,
  yscale=0.1,
  axis x line=center,
  axis y line=center,
  grid = both,
%   xticklabel style = {font=\tiny,yshift=0.5ex},
%   yticklabel style = {font=\tiny,xshift=0.5ex},
%   xlabel style={font=\tiny, xshift=-1.75ex},
%   ylabel style={font=\tiny, yshift=-1.75ex},
  xticklabels=\empty,
  yticklabels=\empty,
  xtick={\xfirst,\xn,...,\xz},
  ytick={\ya,\yn,...,\yz},
  every major tick/.append style={thick, major tick length=5pt, black},
%   xlabel={$x$},
%   ylabel={$y$},
%   xlabel style={below right},
%   ylabel style={above left},
  xmin=\xm1,
  xmax=\xm2,
  ymin=\ym1,
  ymax=\ym2}}
