\usepackage[bottom]{footmisc}

% Named once so a second page style can reuse them rather than restate them.
% Whatever \setsect last set, appended to the course: "-800", or nothing.
\newcommand{\scsection}{}
\makeatletter
% Each gap was \hspace{5pt} *plus* a literal word space -- about
% 8.3pt. The spaces are gone and the 5pt stays, which closes the
% three parts up by about a third without changing the rhythm.
\newcommand{\scheadright}{\sffamily\color{darkgray} \@acadclass{}\scsection\hspace{5pt}\textbullet{}\hspace{5pt}\@date\hspace{5pt}\textbullet{}\hspace{5pt}\@author}
\makeatother
% Whatever \setname last set; a ruled blank until it is called.
\newcommand{\scname}{\underline{\large\phantom{Blank}\hspace{1.25in}}}

% The name has a budget, because the id is centred and so starts
% at a fixed place whatever the name does. Past the budget the
% name is scaled to fit instead of running into "ID:".
%
% 2.1in, chosen by measuring the ink rather than the boxes. The gap
% that matters is from the end of the name to the word "ID:", and
% the `name` and `id` marks do not include that label -- reading the
% gap between them said a 27-character name cleared by 0.10in while
% the render showed it touching.
%
% Measured in ink columns, the name-to-"ID:" gap is:
%
%        name   budget 2.25in   budget 2.1in
%    22 chars         0.34in         0.34in   (not shrunk either way)
%    27 chars         0.16in         0.31in
%    blank            0.30in         0.30in
%
% So 2.1in leaves every case about a third of an inch, and leaves
% the longest name on either roster -- 22 characters -- at full
% size. Only longer ones are scaled, and only by what it takes.
%
% Shrinking on demand rather than always: scaling every name to a
% fixed width would make the short ones enormous.
\newlength{\cipnamebudget}
\setlength{\cipnamebudget}{2.1in}
\newsavebox{\cipnamefit}
\newcommand{\cipfittedname}{%
  \sbox{\cipnamefit}{\scname}%
  \ifdim\wd\cipnamefit>\cipnamebudget
    \resizebox{\cipnamebudget}{!}{\scname}%
  \else\scname\fi}
% One box per digit. Separated digits are the most reliable
% handwriting there is, and this is the only handwriting the system
% has to read -- so it is worth the width. Filled when the run knows
% the student, empty to be written in when it does not, which is what
% lets an unnamed spare be graded at all.
\makeatletter
% One box per character. `\@tfor` walks the digits, so the whole block
% has to be defined with `@` a letter -- not merely used inside one
% pair of \makeatletter, which is how the first attempt defined
% `\@ tfor` and failed at the first named student.
% One grid of nine cells, drawn only when nobody has filled the id
% in. A faint ruled array rather than nine black boxes: it is a place
% to write, not a thing to read, and at the weight of the boxes it
% replaced it competed with the student's own name.
%
% 4.4mm cells. The first version used 1.5ex -- about 1.3mm -- which
% the instructor rightly called too tiny to write in. A digit written
% by an adult wants four to five millimetres.
\newlength{\cipcell}
\setlength{\cipcell}{4.4mm}
\newcommand{\cipidgrid}{%
  % Lowered 1.80pt so the grid's bottom rule meets the blank name's
  % underline. `\underline` draws below the baseline and a
  % `\framebox` stands on it, so they start a rule's-worth apart and
  % no amount of sizing brings them together. Measured off a 600dpi
  % render of this very header; see `align_check.py` in the notes.
  \raisebox{-1.80pt}{%
  \begingroup
  \color{black!30}%
  \setlength{\fboxsep}{0pt}%
  \setlength{\fboxrule}{0.4pt}%
  \framebox{%
    \makebox[\cipcell]{\rule{0pt}{5.2mm}}%
    \@tfor\cipdiv:=12345678\do{%
      \vrule width 0.4pt\makebox[\cipcell]{}}%
  }%
  \endgroup}}

% When the run knows the student the id is simply printed, at the
% size of everything else on this line. It is a fact about the paper,
% not a blank: boxes around a number nobody has to write are noise,
% and the instructor asked for them only in the empty case.
\newcommand{\cipidfield}{%
  \ifx\cipsid\empty\cipidgrid\else\cipsid\fi}

% The blank name rule shortens when the grid is shown, because the
% two together at full width push the course and date off the line.
% `\scname` expands to `\large <name>`, and a size command leaks to
% the end of its group -- which here is the whole header. So the id
% came out at name size. The braces scope it, and the id then sits at
% the size of "Name:" and "MAT 106-820" either side of it.
% Three slots, not two. The id used to follow the name, so it sat
% at a different place on every page and in a different place again
% on a blank run -- which is what read as clunky. fancyhdr's centre
% slot was empty, and it centres on the head regardless of what the
% other two hold, so both kinds of id now land identically.
\newcommand{\scheadleft}{%
  \makebox[2.5in][l]{\sffamily\color{darkgray} Name: %
    {\cipmark{name}{\cipfittedname}}}}
\newcommand{\scheadid}{%
  \ifcipid\sffamily\color{darkgray} ID: \cipmark{id}{\cipidfield}\fi}
\makeatother

\fancyhead[C]{\scheadid}
\fancyhead[R]{\scheadright}
\fancyhead[L]{\scheadleft}
% Titles are long and carry a date -- "Skill Checkpoint Redo
% 2026-10-23" -- so this slot is given a width and a smaller face
% rather than being allowed to run into the centre.
%
% The code goes **outside** the title, which puts it in the corner
% diagonally opposite the grading box on both sides of a sheet: on an
% odd page the title is on the left, so the code is left of it; on an
% even page the title is on the right, so the code is right of it.
% Two slots rather than one, because `[RE, LO]` is a single slot and
% the order has to differ.
% The title at its own size, as it always was. It fits beside the
% code because the instructor shortened what he calls a run -- "SC
% Redo 10/23" rather than "Skill Checkpoint Redo 2026-10-23".
%
% The box is spacing, not a clip: a title long enough to overflow
% 1.9in will still run into the version string in the centre. The
% centre spans roughly 2.75in to 4.25in of a 7in line, so everything
% left of it has to finish by 2.75in. The box is still 1.9in: the
% code shrinking from 11mm to 9mm moved the title 2mm left and
% left the room it has unchanged.
\fancyfoot[LO]{\cippagemark\hspace{0.6em}%
  \makebox[1.9in][l]{\maketitle}}
\fancyfoot[RE]{\makebox[1.9in][r]{\maketitle}%
  \hspace{0.6em}\cippagemark}
% Just the version again. The run seed was printed here as a dashed
% suffix so a loose sheet could be traced by eye -- but it is in the
% code now, and the code is the thing that will actually be read.
% Two copies of a ten-digit number on every page, one of them for a
% case the other already covers, is clutter.
\fancyfoot[C]{\sffamily\textit{\color{darkgray}v\vseed}}
\fancyfoot[LE, RO]{\sffamily\textit{\color{darkgray}%
  \currentskill\hspace{0.5em}\cipmark{box}{\roundbox{20pt}}}}

% The second and later sheets of a skill that runs past one page.
%
% Everything stays except the skill name and the grading box. The title and the
% version keep a loose second sheet identifiable and let it be matched back to
% its first page, which is what a sheet separated from its partner needs. The
% box is what an instructor ticks, and one skill should be ticked once, so it
% appears on the first sheet alone.
%
% Use \thispagestyle{skillcontinued}, never \fancyfoot{} -- this document holds
% every student's paper end to end, so a change to the running footer would
% follow through into everyone after.
\fancypagestyle{skillcontinued}{%
    \fancyhf{}%
    \renewcommand{\headrulewidth}{0pt}%
    \fancyhead[C]{\scheadid}%
    \fancyhead[R]{\scheadright}%
    \fancyhead[L]{\scheadleft}%
    % A continued sheet carries the code too -- it is the sheet that
    % most needs to say which paper it belongs to -- in the same
    % corner as on a first sheet.
    \fancyfoot[LO]{\cippagemark\hspace{0.6em}%
      \makebox[1.9in][l]{\maketitle}}%
    \fancyfoot[RE]{\makebox[1.9in][r]{\maketitle}%
      \hspace{0.6em}\cippagemark}%
    \fancyfoot[C]{\sffamily\textit{\color{darkgray}v\vseed}}%
}

\newcommand{\cacadclass}{
\makeatletter
\@acadclass{}
\makeatother
}

% Changes the name itself rather than the header that shows it, so every page
% style renders the same one. Redefining \fancyhead[L] here would set the name
% for the `fancy` style alone, and a continued sheet -- which uses its own style
% -- would come out with a blank rule where the student's name should be.
\newcommand{\setname}[1]{%
    \ifthenelse{\equal{#1}{Blank} \OR \equal{#1}{blank}}%
        {\renewcommand{\scname}{\underline{\large\phantom{Blank}\hspace{1.25in}}}}%
        {\renewcommand{\scname}{\large #1}}%
    \pdfbookmark[0]{\texorpdfstring{#1}{#1}}{#1}%
}

% Sets the section, not the header that shows it -- same reason as \setname
% above. Redefining \fancyhead[R] here would leave a continued sheet, which uses
% its own page style, showing "MAT 106" where the first sheet says "MAT 106-800".
\newcommand{\setsect}[1]{%
    \ifthenelse{\equal{#1}{Blank} \OR \equal{#1}{blank}}%
        {\renewcommand{\scsection}{}}%
        {\renewcommand{\scsection}{-#1}}%
}

