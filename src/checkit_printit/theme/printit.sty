% ---------------------------------------------------------------------
% What a page carries so it can be read back (design 14.5)
%
% Three marks, and the reason for each:
%
%   \runseed   the run this sheet belongs to, printed after the version
%              as `v715-1513199331`. A loose sheet can then be traced to
%              its run by eye, with no equipment.
%   \cipsid    the student id, when the run prints names. Blank runs
%              leave it unset and the header prints empty boxes to write
%              in -- which is what lets an unnamed spare be graded.
%   the code   everything above plus the skill and the sheet number, as
%              a QR in the footer, so splitting a scanned stack needs no
%              OCR at all.
%
% `qrcode` is pure TeX and draws with no external tool, which matters:
% a build must not depend on something the instructor has to install.
\usepackage{qrcode}

\newcommand{\runseed}{0}
\newcommand{\setrunseed}[1]{\renewcommand{\runseed}{#1}}

\newcommand{\cipsid}{}
\newcommand{\setsid}[1]{\renewcommand{\cipsid}{#1}}

% Which sheet of the current skill this is. Reset by \skillheader,
% which runs once at the top of every skill, and stepped in the footer,
% which is expanded once per page at shipout and therefore in order.
\newcounter{cipsheet}
\setcounter{cipsheet}{0}

% The payload. Deliberately a fixed order with a format tag in front:
% Scans will meet codes printed by versions of this file that no longer
% exist, and a reader that cannot tell which layout it is holding has
% to guess.
%
% Uppercase, digits, hyphen and `*` only. **Not** for QR's
% alphanumeric mode: `qrcode.sty` has no such mode -- it writes mode
% indicator 4, binary, for everything, which was checked in the
% package source rather than assumed. The character set is narrow for
% the human reasons instead: a payload that survives being read aloud,
% retyped, or pasted into a log without quoting.
%
% The separator cannot be a hyphen, because a slug has one (W1-E).
\newcommand{\cippayload}{%
  CIP1*\runseed*\currentskill*\vseed*\thecipsheet*\thepage*%
  \ifx\cipsid\empty 0\else\cipsid\fi}

